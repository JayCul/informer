{
  "name": "informer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Informer: privacy-preserving compensation intelligence on Midnight.",
  "scripts": {
    "compact": "compact compile src/informer.compact managed/informer",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node scripts/preflight.js",
    "proof-server": "docker run --rm -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v",
    "sync:zk": "node scripts/sync-zk.js",
    "dev": "npm run sync:zk && npm run provenance && vite",
    "build": "npm run sync:zk && npm run provenance && vite build",
    "preview": "vite preview",
    "provenance": "node scripts/provenance.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "dotenv": "^17.4.2"
  }
}
