# Copy to .env and fill in. .env is gitignored and must never be committed.

# The seed phrase of the wallet that deploys the contract.
# Put it here yourself. It is never read, logged or transmitted by anything
# except the local wallet SDK, and it must not be shared in chat.
MIDNIGHT_SEED=

# Public addresses of the deploying wallet. Not secret, but kept out of the
# repo so a public repo does not permanently link the GitHub account to a wallet.
MIDNIGHT_SHIELDED_ADDRESS=
MIDNIGHT_UNSHIELDED_ADDRESS=

# Local proof server.
PROOF_SERVER=http://127.0.0.1:6300
