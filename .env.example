# Copy to .env. .env is gitignored.
#
# There is no seed here on purpose. Deployment and contributions are signed by
# the Lace extension through the DApp connector, so no private key is ever
# stored in this repo or its environment.

# Public addresses of the wallet used for Preprod. Not secret, but kept out of
# the repo so a public repo does not permanently link a GitHub account to a
# wallet.
MIDNIGHT_SHIELDED_ADDRESS=
MIDNIGHT_UNSHIELDED_ADDRESS=
MIDNIGHT_DUST_ADDRESS=

# Local proof server started with: npm run proof-server
PROOF_SERVER=http://127.0.0.1:6300
