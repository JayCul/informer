pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Informer - a privacy-preserving contribution primitive.
//
// A informer collects contributions from eligible participants and publishes an
// aggregate distribution. The contract verifies that a contribution came from
// an eligible participant and that the same participant has not already
// contributed to this scope, without learning who the participant is.
//
// Salary is the first contribution category; the primitive is not salary
// specific.
// ---------------------------------------------------------------------------

// ---------- Informer parameters (public) ----------
export ledger bucketWidth: Uint<64>;
export ledger minContribution: Uint<64>;
export ledger maxContribution: Uint<64>;
export ledger kAnonymityFloor: Uint<64>;
export ledger informerId: Bytes<32>;
export ledger period: Bytes<32>;

// Informer provenance. Both are set once at deployment and never change.
// policyHash commits to the eligibility policy document this Informer was
// opened under, so a reviewer can confirm the rules were not rewritten after
// contributions started. circuitCommitment commits to the verifier key and
// circuit version, so a reviewer can confirm every contribution in this
// informer was produced by the same audited circuit.
// Both are 32 bytes, set once, and carry no per-contributor information.
export ledger policyHash: Bytes<32>;
export ledger circuitCommitment: Bytes<32>;

// ---------- Public aggregate ----------
export ledger contributionCount: Counter;
export ledger buckets: Map<Uint<8>, Uint<64>>;
export ledger spentNullifiers: Set<Bytes<32>>;

// ---------- Private, never leaves the device ----------
witness contributorSecret(): Bytes<32>;
witness rawContribution(): Uint<64>;
witness contributionBucket(): Uint<8>;

constructor(
  initBucketWidth: Uint<64>,
  initMin: Uint<64>,
  initMax: Uint<64>,
  initFloor: Uint<64>,
  initInformerId: Bytes<32>,
  initPeriod: Bytes<32>,
  initPolicyHash: Bytes<32>,
  initCircuitCommitment: Bytes<32>
) {
  // Informer parameters are deliberately public: participants must be able to
  // audit the band, the bucket width and the k-anonymity floor they are
  // contributing under. disclose() records that this exposure is intended.
  bucketWidth = disclose(initBucketWidth);
  minContribution = disclose(initMin);
  maxContribution = disclose(initMax);
  kAnonymityFloor = disclose(initFloor);
  informerId = disclose(initInformerId);
  period = disclose(initPeriod);
  policyHash = disclose(initPolicyHash);
  circuitCommitment = disclose(initCircuitCommitment);
}

export circuit contribute(): [] {
  const secret = contributorSecret();
  const raw = rawContribution();

  assert(raw >= minContribution, "contribution below informer band");
  assert(raw <= maxContribution, "contribution above informer band");

  const nullifier = persistentHash<Vector<3, Bytes<32>>>(
    [secret, informerId, period]
  );
  assert(!spentNullifiers.member(disclose(nullifier)),
         "already contributed in this period");

  // Compact has no division operator, by design: division is expensive in a
  // ZK circuit. The bucket index is supplied as a witness and constrained by
  // multiplication instead, which pins it to exactly one value.
  const bucket = contributionBucket();
  const lower = (bucket as Uint<64>) * bucketWidth;
  assert(raw >= lower, "bucket index too high for contribution");
  assert(raw < lower + bucketWidth, "bucket index too low for contribution");

  const current = buckets.member(disclose(bucket))
    ? buckets.lookup(disclose(bucket))
    : 0;
  buckets.insert(disclose(bucket), (current + 1) as Uint<64>);

  spentNullifiers.insert(disclose(nullifier));
  contributionCount.increment(1);
}
